<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen and dark: the picture is small and letterboxed, and
         a bright chrome around it is exactly what you do not want to be
         looking at while playing. -->
    <style name="Theme.BottomScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
    </style>
</resources>
