#!/bin/bash
# Root-only, deliberately narrow entry point authorised by the Polkit rule.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

CONFIG=/etc/bottom-screen-gamepad/control.conf
TOOLS=/usr/local/libexec/bottom-screen-gamepad

[ "$(id -u)" -eq 0 ] || { echo "gamepad-ap-control must run as root" >&2; exit 1; }
[ -r "$CONFIG" ] || { echo "missing $CONFIG; run install-polkit.sh" >&2; exit 1; }

# This file is installed root:root 0600.  It contains only shell-escaped
# assignments generated by install-polkit.sh, never user-provided code.
# shellcheck disable=SC1090
. "$CONFIG"
export DRC_IF DRC_AP_MAC DRC_HOSTAP DRC_RUN DRC_MTU DRC_DNSMASQ_CONF
export DRC_UUID DRC_PAIR_CONF DRC_NORMAL_CONF

action=${1:-}
case "$action" in
    start)
        [ "$#" -eq 1 ] || exit 2
        exec /bin/bash "$TOOLS/ap-normal.sh"
        ;;
    stop)
        [ "$#" -eq 1 ] || exit 2
        exec /bin/bash "$TOOLS/ap-stop.sh"
        ;;
    pair)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in (*[!0-9]*|'') echo "invalid pairing PIN" >&2; exit 2;; esac
        [ "${#2}" -eq 8 ] || { echo "invalid pairing PIN" >&2; exit 2; }
        exec /bin/bash "$TOOLS/ap-pair.sh" "$2"
        ;;
    *)
        echo "usage: gamepad-ap-control {start|stop|pair PIN}" >&2
        exit 2
        ;;
esac
